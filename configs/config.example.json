{
  "api_key": "${OC_GO_CC_API_KEY}",
  "host": "127.0.0.1",
  "port": 3456,

  "default_model": "deepseek-v4-pro",

  "model_aliases": {
    "sonnet": "deepseek-v4-pro",
    "opus": "kimi-k2.6",
    "haiku": "deepseek-v4-flash",
    "reasoning": "deepseek-v4-pro",
    "fast": "deepseek-v4-flash",
    "long-context": "minimax-m2.7",
    "balanced": "kimi-k2.6"
  },

  "model_configs": {
    "deepseek-v4-pro": {
      "temperature": 0.1,
      "max_tokens": 8192,
      "reasoning_effort": "max",
      "thinking": { "type": "enabled" }
    },
    "deepseek-v4-flash": {
      "temperature": 0.1,
      "max_tokens": 4096,
      "reasoning_effort": "max",
      "thinking": { "type": "enabled" }
    },
    "kimi-k2.6": {
      "temperature": 0.7,
      "max_tokens": 4096
    },
    "minimax-m2.7": {
      "temperature": 0.7,
      "max_tokens": 16384
    },
    "glm-5.1": {
      "temperature": 0.7,
      "max_tokens": 8192
    },
    "qwen3.6-plus": {
      "temperature": 0.5,
      "max_tokens": 4096
    }
  },

  "fallbacks": [
    "kimi-k2.6",
    "mimo-v2.5-pro",
    "qwen3.6-plus"
  ],

  "opencode_go": {
    "base_url": "https://opencode.ai/zen/go/v1/chat/completions",
    "anthropic_base_url": "https://opencode.ai/zen/go/v1/messages",
    "timeout_ms": 300000
  },

  "logging": {
    "level": "info",
    "requests": true
  }
}
